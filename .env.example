# Copy to .env for Docker Compose local development. Replace demo values before use.
DOCKERHUB_USERNAME=your-dockerhub-username
DB_ROOT_PASSWORD=replace-with-a-unique-root-password
DB_PASSWORD=replace-with-a-unique-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@hostel.local
ADMIN_PASSWORD=replace-with-a-unique-admin-password
CORS_ORIGIN=*
FRONTEND_PORT=8080
BACKEND_PORT=5000
